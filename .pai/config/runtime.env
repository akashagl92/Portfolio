# Canonical PAI runtime configuration (portable, IDE-agnostic)
# This file is source-of-truth for mode vocabulary and capability toggles.

PROFILE=NATIVE
LOCKED=0
REASON=bootstrap_default_native

# Sub-agent master switch:
# 1 = allow spawned lanes when workflows request them and policy allows them.
# 0 = force single-parent operation even if spawn capability exists.
SUBAGENT_ENABLED=1
# Canonical modes:
# single_parent = no child lane; main agent handles research, build, and synthesis.
# proposal_only = recommended default; child lanes may inspect, analyze, and propose only.
# scoped_write = exception mode; child lanes may perform tightly-scoped writes with explicit approval.
# Legacy `research_only` is treated as `proposal_only`.
SUBAGENT_MODE=scoped_write
# Recommended default: keep `proposal_only` unless there is a deliberate reason to relax or disable it.
# Use `single_parent` for maximum safety or debugging.
# Use `scoped_write` only when you intentionally accept child-file mutation risk.
# Hybrid test mode convention:
# - Main lane: PROFILE=NATIVE and LOCKED=0 (set via runtime guard).
# - Child lanes: SUBAGENT_MODE=scoped_write with policy allowlist to ephemeral paths only.
SUBAGENT_MAX_CONCURRENCY=2
SUBAGENT_TIMEOUT_SEC=180
# Parent-only shared orchestration writes:
# 1 = only the parent may update shared task/plan/walkthrough artifacts.
# 0 = child lanes may be allowed to write more broadly by policy.
SUBAGENT_PARENT_ONLY_WRITES=1
# Native artifact access from child lanes:
# 0 = child lanes must not use native artifact mutation paths.
# 1 = child lanes may use native writes if policy and mode permit.
SUBAGENT_NATIVE_WRITES=0
# Spawn capability exposure:
# 1 = workflows may request spawned sub-agent lanes.
# 0 = workflows should stay in single-parent fallback mode.
CAPABILITY_SPAWN_SUBAGENT=1

# Event bus settings
PAI_EVENT_BUS_ENABLED=1
PAI_EVENT_LOG=.pai/events/events.jsonl

# Policy settings
PAI_POLICY_ENABLED=1
PAI_POLICY_FILE=.pai/config/policy.json

# KPI window settings: rolling | lifetime
PAI_KPI_WINDOW_MODE=rolling
# Used when mode=rolling
PAI_KPI_WINDOW_SIZE=20
# Include reconciled stale jobs in KPI window: 0|1
PAI_KPI_INCLUDE_RECONCILED=0
# Refresh telemetry before quality evaluation: 0|1
PAI_QUALITY_REFRESH_TELEMETRY=1

# Native artifact race-condition mitigation controls
PAI_NATIVE_TIMEOUT_SEC=20
PAI_NATIVE_LOCK_TTL_SEC=120
PAI_NATIVE_LOCK_WAIT_SEC=30
PAI_NATIVE_BREAKER_THRESHOLD=2
PAI_NATIVE_BREAKER_COOLDOWN_SEC=300
PAI_NATIVE_RETRY_MAX=2
PAI_NATIVE_REPLAY_ENABLED=1
PAI_NATIVE_AUTO_SHADOW_ON_OPEN=1
PAI_NATIVE_QUEUE_ON_FAILURE=1
# Native artifact (task/implementation_plan/walkthrough) fallback automation
PAI_NATIVE_ARTIFACT_AUTO_FALLBACK_ENABLED=1
PAI_NATIVE_ARTIFACT_STALL_TIMEOUT_SEC=180
PAI_NATIVE_ARTIFACT_OBSERVE_ONLY=0
PAI_NATIVE_ARTIFACT_ONE_WAY_SHADOW=1
PAI_NATIVE_SHADOW_ENFORCE_BLOCK=1
PAI_NATIVE_ARTIFACT_BRIDGE_ENABLED=1
PAI_NATIVE_ARTIFACT_SOURCE_ROOT=$HOME/.gemini/antigravity/brain
PAI_NATIVE_ARTIFACT_BRIDGE_POLL_SEC=5
PAI_NATIVE_ARTIFACT_BRIDGE_IDLE_END_SEC=30
PAI_RUNTIME_AUTO_ENSURE_BRIDGE=1
PAI_SHADOW_ALLOWED_ARTIFACT_PATHS=.pai/tasks/todo.md,.pai/plans/active_plan.md,.pai/walkthrough-final.md
